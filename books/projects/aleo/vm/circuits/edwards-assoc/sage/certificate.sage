# Generates certificate-data.lisp: Nullstellensatz-style certificates for
# associativity of twisted Edwards addition over Z[a,d,...].
#
#   sage certificate.sage > ../certificate-data.lisp
#
# Variables x4,y4 stand for P1+P2, x6,y6 for P2+P3, (xl,yl) for (P1+P2)+P3 and
# (xr,yr) for P1+(P2+P3).  Each generator g below is zero in the prime field
# (curve equations, and "denominator * quotient - numerator" for each division
# in twisted-edwards-add).  For each coordinate we produce cofactors k_i with
#
#   goal = sum_i k_i * g_i     in Z[vars],
#
# where goal = (xl - xr) * (product of the six denominators), and similarly
# for y.

import sys

R = PolynomialRing(ZZ, 'a,d,x1,y1,x2,y2,x3,y3,x4,y4,x6,y6,xl,xr,yl,yr',
                   order='degrevlex')
a,d,x1,y1,x2,y2,x3,y3,x4,y4,x6,y6,xl,xr,yl,yr = R.gens()

def curve(x, y):
    return a*x*x + y*y - (1 + d*(x*x)*(y*y))

C = [curve(x1,y1), curve(x2,y2), curve(x3,y3)]

e12 = d*x1*x2*y1*y2; nx12 = x1*y2 + y1*x2; ny12 = y1*y2 - a*x1*x2
e23 = d*x2*x3*y2*y3; nx23 = x2*y3 + y2*x3; ny23 = y2*y3 - a*x2*x3
D1 = 1 + e12; D2 = 1 - e12; D4 = 1 + e23; D5 = 1 - e23
e43 = d*x4*x3*y4*y3; e16 = d*x1*x6*y1*y6
D3x = 1 + e43; D3y = 1 - e43; D6x = 1 + e16; D6y = 1 - e16

H1 = D1*x4 - nx12
H2 = D2*y4 - ny12
H4 = D4*x6 - nx23
H5 = D5*y6 - ny23
H3x = D3x*xl - (x4*y3 + y4*x3)
H6x = D6x*xr - (x1*y6 + y1*x6)
H3y = D3y*yl - (y4*y3 - a*(x4*x3))
H6y = D6y*yr - (y1*y6 - a*(x1*x6))

# Base-variable numerators and denominators of the composed sums.
NLx = nx12*y3*D2 + ny12*x3*D1; DLxb = D1*D2 + d*x3*y3*nx12*ny12
NLy = ny12*y3*D1 - a*nx12*x3*D2; DLyb = D1*D2 - d*x3*y3*nx12*ny12
NRx = x1*ny23*D4 + y1*nx23*D5; DRxb = D4*D5 + d*x1*y1*nx23*ny23
NRy = y1*ny23*D4 - a*x1*nx23*D5; DRyb = D4*D5 - d*x1*y1*nx23*ny23

def curve_cofactors(diff):
    I = R.change_ring(QQ).ideal([R.change_ring(QQ)(c) for c in C])
    cof = R.change_ring(QQ)(diff).lift(I)
    cof = [R(c) for c in cof]
    assert diff == sum(c*g for c, g in zip(cof, C))
    return cof

def certificate(coord):
    if coord == 'x':
        DL = D1*D2*D3x; DR = D4*D5*D6x
        NL, NR, DLb, DRb = NLx, NRx, DLxb, DRxb
        H3, H6 = H3x, H6x
        goal = (xl - xr)*DL*DR
        s = 1
        # xl*DL = NL + KL,  xr*DR = NR + KR
        kl = {1: y3*D2, 2: x3*D1, 3: D1*D2}
        kr = {4: y1*D5, 5: x1*D4, 6: D4*D5}
    else:
        DL = D1*D2*D3y; DR = D4*D5*D6y
        NL, NR, DLb, DRb = NLy, NRy, DLyb, DRyb
        H3, H6 = H3y, H6y
        goal = (yl - yr)*DL*DR
        s = -1
        kl = {1: -a*x3*D2, 2: y3*D1, 3: D1*D2}
        kr = {4: -a*x1*D5, 5: y1*D4, 6: D4*D5}
    gens = {1: H1, 2: H2, 3: H3, 4: H4, 5: H5, 6: H6}
    assert goal.parent() is R
    assert (xl if coord == 'x' else yl)*DL == NL + sum(kl[i]*gens[i] for i in kl)
    assert (xr if coord == 'x' else yr)*DR == NR + sum(kr[i]*gens[i] for i in kr)
    # DL - DLb = s*d*x3*y3*(H1*(H2+ny12) + nx12*H2), likewise DR.
    assert DL - DLb == s*d*x3*y3*(H1*(H2 + ny12) + nx12*H2)
    assert DR - DRb == s*d*x1*y1*(H4*(H5 + ny23) + nx23*H5)
    c = curve_cofactors(NL*DRb - NR*DLb)
    # goal = NL*DR - NR*DL + KL*DR - KR*DL
    #      = sum c_j C_j + NL*(DR-DRb) - NR*(DL-DLb) + KL*DR - KR*DL
    k = {}
    k[1] = kl[1]*DR - NR*s*d*x3*y3*(H2 + ny12)
    k[2] = kl[2]*DR - NR*s*d*x3*y3*nx12
    k[3] = kl[3]*DR
    k[4] = -kr[4]*DL + NL*s*d*x1*y1*(H5 + ny23)
    k[5] = -kr[5]*DL + NL*s*d*x1*y1*nx23
    k[6] = -kr[6]*DL
    gl = [gens[i] for i in range(1, 7)] + C
    kk = [k[i] for i in range(1, 7)] + c
    assert goal == sum(ki*gi for ki, gi in zip(kk, gl))
    return kk, c

names = [str(v) for v in R.gens()]

def mono_term(c, exps):
    factors = []
    for v, e in zip(names, exps):
        if e == 1:
            factors.append(v)
        elif e > 1:
            factors.append('(expt %s %d)' % (v, e))
    if c != 1 or not factors:
        factors = [str(c)] + factors
    t = factors[-1]
    for f in reversed(factors[:-1]):
        t = '(* %s %s)' % (f, t)
    return t

def poly_term(p):
    terms = [mono_term(c, m.exponents()[0]) for c, m in zip(p.coefficients(), p.monomials())]
    if not terms:
        return '0'
    out = terms[-1]
    for t in reversed(terms[:-1]):
        out = '(+ %s\n   %s)' % (t, out)
    return out

out = sys.stdout
out.write(';; Generated by sage/certificate.sage; do not edit.\n\n')
out.write('(in-package "ECURVE")\n\n')
for coord in ['x', 'y']:
    kk, c = certificate(coord)
    sys.stderr.write('%s: cofactor terms %s, curve cofactor terms %s, max degree %d\n'
                     % (coord, [len(k.monomials()) for k in kk],
                        [len(ci.monomials()) for ci in c],
                        max(k.degree() for k in kk)))
    out.write('(defconst *edwards-assoc-cofactors-%s*\n  (list\n' % coord)
    for ki in kk:
        out.write("   '%s\n" % poly_term(ki))
    out.write('   ))\n\n')
