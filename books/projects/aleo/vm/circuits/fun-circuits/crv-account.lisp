; Compute-key and signature equality.
; ComputeKey::is_equal is group equality on pk_sig and on pr_sig and scalar
; equality on sk_prf, then boolean and of the three bits.
; The scalar is_equal bit is the linear combination 1 - r, so the last and
; is (t) * (1 - r) = (out).
; Signature::is_equal is the same shape on challenge, response, and the
; compute key.
; is_not_equal reuses the constraints; the result is 1 - out.

(in-package "ALEOVM")

(include-book "crv-equal")
(include-book "../r1cs/boolean-and")

(local (include-book "kestrel/prime-fields/prime-fields-rules" :dir :system))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define crv-and-var-not-gadget ((x symbolp) (r symbolp) (out symbolp) (p primep))
  :returns (constrs r1cs::r1cs-constraint-listp :hyp :guard)
  :short "(x) * (1 - r) = (out)."
  (list (r1cs::make-r1cs-constraint
         :a (list (list 1 x))
         :b (list (list 1 1) (list (1- p) r))
         :c (list (list 1 out)))))

(defruled crv-and-var-not-gadget-to-mul
  (implies (and (symbolp x) (symbolp r) (symbolp out)
                (primep p)
                (r1cs::r1cs-valuationp asg p)
                (r1cs::valuation-bindsp asg x)
                (r1cs::valuation-bindsp asg r)
                (r1cs::valuation-bindsp asg out))
           (equal (r1cs::r1cs-constraints-holdp
                   (crv-and-var-not-gadget x r out p) asg p)
                  (equal (pfield::mul (lookup-equal x asg)
                                      (pfield::sub 1 (lookup-equal r asg) p)
                                      p)
                         (lookup-equal out asg))))
  :enable (crv-and-var-not-gadget
           r1cs::r1cs-constraint-holdsp
           r1cs::dot-product))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; The proof generated by pfcs::lift opens eval-expr-list by its recursive
; definition, which takes time exponential in the number of parameters.
; crv-fast-lift-fn is pfcs::lift-fn with that definition replaced by the two
; rules below in the theory of the generated theorem.

(local
 (defruled crv-eval-expr-list-of-cons
   (equal (pfcs::eval-expr-list (cons expr exprs) asg p)
          (let ((val (pfcs::eval-expr expr asg p)))
            (if (reserrp val)
                val
              (let ((vals (pfcs::eval-expr-list exprs asg p)))
                (if (reserrp vals)
                    vals
                  (cons val vals))))))
   :enable pfcs::eval-expr-list))

(local
 (defruled crv-eval-expr-list-of-nil
   (equal (pfcs::eval-expr-list nil asg p) nil)
   :enable pfcs::eval-expr-list))

(local
 (defun crv-fast-lift-event (event thm)
   (declare (xargs :mode :program))
   (cond ((atom event) event)
         ((and (eq (car event) 'defruled) (eq (cadr event) thm))
          (let* ((tail (member-eq :in-theory event))
                 (theory (cadr (cadr tail))))
            (append (take (- (len event) (len tail)) event)
                    (list :in-theory
                          (list 'quote
                                (append '(crv-eval-expr-list-of-cons
                                          crv-eval-expr-list-of-nil)
                                        (remove-equal 'pfcs::eval-expr-list
                                                      theory))))
                    (cddr tail))))
         (t (cons (crv-fast-lift-event (car event) thm)
                  (crv-fast-lift-event (cdr event) thm))))))

(local
 (defun crv-fast-lift-fn (def pred prime state)
   (declare (xargs :mode :program :stobjs state))
   (crv-fast-lift-event (pfcs::lift-fn def pred prime state)
                        (acl2::packn-pos (list 'definition-satp-to- pred)
                                         pred))))

(define crv-compute-key-is-equal-gadget
  ((pk1x symbolp) (pk1y symbolp) (pk2x symbolp) (pk2y symbolp)
   (pkmx symbolp) (pkrx symbolp) (pkmy symbolp) (pkry symbolp) (pkout symbolp)
   (pr1x symbolp) (pr1y symbolp) (pr2x symbolp) (pr2y symbolp)
   (prmx symbolp) (prrx symbolp) (prmy symbolp) (prry symbolp) (prout symbolp)
   (s1 symbolp) (s2 symbolp) (sm symbolp) (sr symbolp)
   (t1 symbolp) (out symbolp)
   (p primep))
  :returns (constrs r1cs::r1cs-constraint-listp :hyp :guard)
  (append (crv-group-is-equal-gadget
           pk1x pk1y pk2x pk2y pkmx pkrx pkmy pkry pkout p)
          (crv-group-is-equal-gadget
           pr1x pr1y pr2x pr2y prmx prrx prmy prry prout p)
          (crv-scalar-is-equal-gadget s1 s2 sm sr p)
          (boolean-and-gadget pkout prout t1)
          (crv-and-var-not-gadget t1 sr out p)))

(defruled crv-equal-of-three-element-lists
  (implies (and (true-listp x)
                (true-listp y)
                (equal (len x) 3)
                (equal (len y) 3))
           (equal (equal x y)
                  (and (equal (first x) (first y))
                       (equal (second x) (second y))
                       (equal (third x) (third y)))))
  :hints (("Goal"
           :in-theory (enable len true-listp)
           :expand ((len x) (len (cdr x)) (len (cddr x))
                    (len y) (len (cdr y)) (len (cddr y))
                    (true-listp x) (true-listp (cdr x)) (true-listp (cddr x))
                    (true-listp y) (true-listp (cdr y)) (true-listp (cddr y))))))

(defruled crv-compute-key-equal-iff-components
  (implies (and (curve-compute-keyp ck1)
                (curve-compute-keyp ck2))
           (equal (equal ck1 ck2)
                  (and (equal (first ck1) (first ck2))
                       (equal (second ck1) (second ck2))
                       (equal (third ck1) (third ck2)))))
  :enable (curve-compute-keyp crv-equal-of-three-element-lists))

(defruled crv-compute-key-is-equal-gadget-sound
  (implies (and (symbolp pk1x) (symbolp pk1y) (symbolp pk2x) (symbolp pk2y)
                (symbolp pkmx) (symbolp pkrx) (symbolp pkmy) (symbolp pkry)
                (symbolp pkout)
                (symbolp pr1x) (symbolp pr1y) (symbolp pr2x) (symbolp pr2y)
                (symbolp prmx) (symbolp prrx) (symbolp prmy) (symbolp prry)
                (symbolp prout)
                (symbolp s1) (symbolp s2) (symbolp sm) (symbolp sr)
                (symbolp t1) (symbolp out)
                (equal p (base-prime))
                (r1cs::r1cs-valuationp asg p)
                (r1cs::valuation-bindsp asg pk1x)
                (r1cs::valuation-bindsp asg pk1y)
                (r1cs::valuation-bindsp asg pk2x)
                (r1cs::valuation-bindsp asg pk2y)
                (r1cs::valuation-bindsp asg pkmx)
                (r1cs::valuation-bindsp asg pkrx)
                (r1cs::valuation-bindsp asg pkmy)
                (r1cs::valuation-bindsp asg pkry)
                (r1cs::valuation-bindsp asg pkout)
                (r1cs::valuation-bindsp asg pr1x)
                (r1cs::valuation-bindsp asg pr1y)
                (r1cs::valuation-bindsp asg pr2x)
                (r1cs::valuation-bindsp asg pr2y)
                (r1cs::valuation-bindsp asg prmx)
                (r1cs::valuation-bindsp asg prrx)
                (r1cs::valuation-bindsp asg prmy)
                (r1cs::valuation-bindsp asg prry)
                (r1cs::valuation-bindsp asg prout)
                (r1cs::valuation-bindsp asg s1)
                (r1cs::valuation-bindsp asg s2)
                (r1cs::valuation-bindsp asg sm)
                (r1cs::valuation-bindsp asg sr)
                (r1cs::valuation-bindsp asg t1)
                (r1cs::valuation-bindsp asg out)
                (curve-compute-keyp ck1)
                (curve-compute-keyp ck2)
                (equal (lookup-equal pk1x asg)
                       (ecurve::point-finite->x (first ck1)))
                (equal (lookup-equal pk1y asg)
                       (ecurve::point-finite->y (first ck1)))
                (equal (lookup-equal pk2x asg)
                       (ecurve::point-finite->x (first ck2)))
                (equal (lookup-equal pk2y asg)
                       (ecurve::point-finite->y (first ck2)))
                (equal (lookup-equal pr1x asg)
                       (ecurve::point-finite->x (second ck1)))
                (equal (lookup-equal pr1y asg)
                       (ecurve::point-finite->y (second ck1)))
                (equal (lookup-equal pr2x asg)
                       (ecurve::point-finite->x (second ck2)))
                (equal (lookup-equal pr2y asg)
                       (ecurve::point-finite->y (second ck2)))
                (equal (lookup-equal s1 asg) (third ck1))
                (equal (lookup-equal s2 asg) (third ck2))
                (bitp (lookup-equal pkrx asg))
                (bitp (lookup-equal pkry asg))
                (bitp (lookup-equal prrx asg))
                (bitp (lookup-equal prry asg))
                (bitp (lookup-equal sr asg))
                (bitp (lookup-equal pkout asg))
                (bitp (lookup-equal prout asg))
                (bitp (lookup-equal t1 asg))
                (r1cs::r1cs-constraints-holdp
                 (crv-compute-key-is-equal-gadget
                  pk1x pk1y pk2x pk2y pkmx pkrx pkmy pkry pkout
                  pr1x pr1y pr2x pr2y prmx prrx prmy prry prout
                  s1 s2 sm sr t1 out p)
                 asg p))
           (equal (lookup-equal out asg)
                  (compute-key-is-equal-funspec ck1 ck2)))
  :hints (("Goal"
           :in-theory (e/d (crv-compute-key-is-equal-gadget
                            r1cs::r1cs-constraints-holdp-of-append
                            boolean-and-gadget-to-bitand
                            crv-and-var-not-gadget-to-mul
                            crv-bitand-is-boolean-and-funspec
                            crv-mul-of-bits-is-and
                            boolean-and-funspec
                            boolean-not-funspec
                            compute-key-is-equal-funspec
                            group-is-equal-funspec
                            scalar-is-equal-funspec
                            crv-compute-key-equal-iff-components
                            crv-not-of-equal-bit)
                           ((:definition pfield::sub)
                            pfield::mul-of-sub-arg1
                            pfield::mul-of-sub-arg2))
           :use ((:instance crv-group-is-equal-gadget-sound
                            (x1 pk1x) (y1 pk1y) (x2 pk2x) (y2 pk2y)
                            (mx pkmx) (rx pkrx) (my pkmy) (ry pkry)
                            (out pkout)
                            (p1 (first ck1)) (p2 (first ck2)))
                 (:instance crv-group-is-equal-gadget-sound
                            (x1 pr1x) (y1 pr1y) (x2 pr2x) (y2 pr2y)
                            (mx prmx) (rx prrx) (my prmy) (ry prry)
                            (out prout)
                            (p1 (second ck1)) (p2 (second ck2)))
                 (:instance crv-scalar-is-equal-gadget-sound
                            (a s1) (b s2) (m sm) (r sr))))))

(defconst *crv-compute-key-is-equal-sample*
  '((pk1x . 0) (pk1y . 1) (pk2x . 0) (pk2y . 1)
    (pkmx . 0) (pkrx . 0) (pkmy . 0) (pkry . 0) (pkout . 1)
    (pr1x . 0) (pr1y . 1) (pr2x . 0) (pr2y . 1)
    (prmx . 0) (prrx . 0) (prmy . 0) (prry . 0) (prout . 1)
    (s1 . 0) (s2 . 0) (sm . 0) (sr . 0)
    (t1 . 1) (out . 1)))

(defruled crv-compute-key-is-equal-sample-holds
  (implies (and (equal p (base-prime))
                (r1cs::r1cs-valuationp *crv-compute-key-is-equal-sample* p)
                (fieldp 0) (fieldp 1) (scalarp 0))
           (r1cs::r1cs-constraints-holdp
            (crv-compute-key-is-equal-gadget
             'pk1x 'pk1y 'pk2x 'pk2y 'pkmx 'pkrx 'pkmy 'pkry 'pkout
             'pr1x 'pr1y 'pr2x 'pr2y 'prmx 'prrx 'prmy 'prry 'prout
             's1 's2 'sm 'sr 't1 'out p)
            *crv-compute-key-is-equal-sample* p))
  :enable (crv-compute-key-is-equal-gadget
           crv-group-is-equal-gadget
           crv-field-is-not-equal-gadget-to-spec
           crv-and-not-gadget-to-mul
           crv-and-var-not-gadget-to-mul
           boolean-and-gadget
           r1cs::r1cs-constraint-holdsp
           r1cs::dot-product
           lookup-equal)
  :disable ((:definition pfield::sub) pfield::mul-of-sub-arg1))

(define crv-compute-key-is-equal-circuit ()
  :returns (pdef pfcs::definitionp)
  (pfcs::parse-def
   "crv_compute_key_is_equal(pk1x, pk1y, pk2x, pk2y, pkmx, pkrx, pkmy, pkry, pkout, pr1x, pr1y, pr2x, pr2y, prmx, prrx, prmy, prry, prout, s1, s2, sm, sr, t1, out) := {
    (pk1x - pk2x) * (pkmx) == (pkrx),
    (pk1x - pk2x) * (1 - pkrx) == (0),
    (pk1y - pk2y) * (pkmy) == (pkry),
    (pk1y - pk2y) * (1 - pkry) == (0),
    (1 - pkrx) * (1 - pkry) == (pkout),
    (pr1x - pr2x) * (prmx) == (prrx),
    (pr1x - pr2x) * (1 - prrx) == (0),
    (pr1y - pr2y) * (prmy) == (prry),
    (pr1y - pr2y) * (1 - prry) == (0),
    (1 - prrx) * (1 - prry) == (prout),
    (s1 - s2) * (sm) == (sr),
    (s1 - s2) * (1 - sr) == (0),
    (pkout) * (prout) == (t1),
    (t1) * (1 - sr) == (out)
    }")
  ///
  (more-returns
   (pdef pfcs::sr1cs-definitionp
         :hints (("Goal" :in-theory (enable pfcs::sr1cs-definitionp
                                            pfcs::sr1cs-constraintp
                                            pfcs::r1cs-constraintp
                                            pfcs::r1cs-polynomialp
                                            pfcs::r1cs-monomialp))))))

(make-event (crv-fast-lift-fn (crv-compute-key-is-equal-circuit)
                             'crv-compute-key-is-equal-pred
                             'prime
                             state))

(define crv-compute-key-is-not-equal-gadget
  ((pk1x symbolp) (pk1y symbolp) (pk2x symbolp) (pk2y symbolp)
   (pkmx symbolp) (pkrx symbolp) (pkmy symbolp) (pkry symbolp) (pkout symbolp)
   (pr1x symbolp) (pr1y symbolp) (pr2x symbolp) (pr2y symbolp)
   (prmx symbolp) (prrx symbolp) (prmy symbolp) (prry symbolp) (prout symbolp)
   (s1 symbolp) (s2 symbolp) (sm symbolp) (sr symbolp)
   (t1 symbolp) (out symbolp)
   (p primep))
  :returns (constrs r1cs::r1cs-constraint-listp :hyp :guard)
  (crv-compute-key-is-equal-gadget
   pk1x pk1y pk2x pk2y pkmx pkrx pkmy pkry pkout
   pr1x pr1y pr2x pr2y prmx prrx prmy prry prout
   s1 s2 sm sr t1 out p))

(defruled crv-compute-key-is-not-equal-gadget-sound
  (implies (and (symbolp pk1x) (symbolp pk1y) (symbolp pk2x) (symbolp pk2y)
                (symbolp pkmx) (symbolp pkrx) (symbolp pkmy) (symbolp pkry)
                (symbolp pkout)
                (symbolp pr1x) (symbolp pr1y) (symbolp pr2x) (symbolp pr2y)
                (symbolp prmx) (symbolp prrx) (symbolp prmy) (symbolp prry)
                (symbolp prout)
                (symbolp s1) (symbolp s2) (symbolp sm) (symbolp sr)
                (symbolp t1) (symbolp out)
                (equal p (base-prime))
                (r1cs::r1cs-valuationp asg p)
                (r1cs::valuation-bindsp asg pk1x)
                (r1cs::valuation-bindsp asg pk1y)
                (r1cs::valuation-bindsp asg pk2x)
                (r1cs::valuation-bindsp asg pk2y)
                (r1cs::valuation-bindsp asg pkmx)
                (r1cs::valuation-bindsp asg pkrx)
                (r1cs::valuation-bindsp asg pkmy)
                (r1cs::valuation-bindsp asg pkry)
                (r1cs::valuation-bindsp asg pkout)
                (r1cs::valuation-bindsp asg pr1x)
                (r1cs::valuation-bindsp asg pr1y)
                (r1cs::valuation-bindsp asg pr2x)
                (r1cs::valuation-bindsp asg pr2y)
                (r1cs::valuation-bindsp asg prmx)
                (r1cs::valuation-bindsp asg prrx)
                (r1cs::valuation-bindsp asg prmy)
                (r1cs::valuation-bindsp asg prry)
                (r1cs::valuation-bindsp asg prout)
                (r1cs::valuation-bindsp asg s1)
                (r1cs::valuation-bindsp asg s2)
                (r1cs::valuation-bindsp asg sm)
                (r1cs::valuation-bindsp asg sr)
                (r1cs::valuation-bindsp asg t1)
                (r1cs::valuation-bindsp asg out)
                (curve-compute-keyp ck1)
                (curve-compute-keyp ck2)
                (equal (lookup-equal pk1x asg)
                       (ecurve::point-finite->x (first ck1)))
                (equal (lookup-equal pk1y asg)
                       (ecurve::point-finite->y (first ck1)))
                (equal (lookup-equal pk2x asg)
                       (ecurve::point-finite->x (first ck2)))
                (equal (lookup-equal pk2y asg)
                       (ecurve::point-finite->y (first ck2)))
                (equal (lookup-equal pr1x asg)
                       (ecurve::point-finite->x (second ck1)))
                (equal (lookup-equal pr1y asg)
                       (ecurve::point-finite->y (second ck1)))
                (equal (lookup-equal pr2x asg)
                       (ecurve::point-finite->x (second ck2)))
                (equal (lookup-equal pr2y asg)
                       (ecurve::point-finite->y (second ck2)))
                (equal (lookup-equal s1 asg) (third ck1))
                (equal (lookup-equal s2 asg) (third ck2))
                (bitp (lookup-equal pkrx asg))
                (bitp (lookup-equal pkry asg))
                (bitp (lookup-equal prrx asg))
                (bitp (lookup-equal prry asg))
                (bitp (lookup-equal sr asg))
                (bitp (lookup-equal pkout asg))
                (bitp (lookup-equal prout asg))
                (bitp (lookup-equal t1 asg))
                (r1cs::r1cs-constraints-holdp
                 (crv-compute-key-is-not-equal-gadget
                  pk1x pk1y pk2x pk2y pkmx pkrx pkmy pkry pkout
                  pr1x pr1y pr2x pr2y prmx prrx prmy prry prout
                  s1 s2 sm sr t1 out p)
                 asg p))
           (equal (pfield::sub 1 (lookup-equal out asg) p)
                  (compute-key-is-not-equal-funspec ck1 ck2)))
  :hints (("Goal"
           :use (:instance crv-compute-key-is-equal-gadget-sound)
           :in-theory (e/d (crv-compute-key-is-not-equal-gadget
                            compute-key-is-not-equal-funspec
                            compute-key-is-equal-funspec)
                           (crv-compute-key-is-equal-gadget-sound
                            (:definition pfield::sub)
                            pfield::mul-of-sub-arg1)))))

(defconst *crv-compute-key-is-not-equal-sample*
  *crv-compute-key-is-equal-sample*)

(defruled crv-compute-key-is-not-equal-sample-holds
  (implies (and (equal p (base-prime))
                (r1cs::r1cs-valuationp *crv-compute-key-is-not-equal-sample* p)
                (fieldp 0) (fieldp 1) (scalarp 0))
           (r1cs::r1cs-constraints-holdp
            (crv-compute-key-is-not-equal-gadget
             'pk1x 'pk1y 'pk2x 'pk2y 'pkmx 'pkrx 'pkmy 'pkry 'pkout
             'pr1x 'pr1y 'pr2x 'pr2y 'prmx 'prrx 'prmy 'prry 'prout
             's1 's2 'sm 'sr 't1 'out p)
