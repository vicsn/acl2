(in-package "ECURVE")

;; Let L be the list of all points of a complete twisted Edwards curve and N
;; its length.  Translating every element of L by a point Q permutes L, so the
;; sum S of L satisfies S = S + N Q, hence N Q = 0.  This is the abelian-group
;; form of Lagrange's theorem for the cyclic subgroup generated by Q.

(include-book "basics")
(include-book "point-list")
(include-book "kestrel/lists-light/perm" :dir :system)

(local (include-book "kestrel/lists-light/set-difference-equal" :dir :system))
(local (include-book "kestrel/lists-light/remove1-equal" :dir :system))

(define te-all-on-curve-p ((l true-listp) (curve twisted-edwards-curvep))
  :verify-guards nil
  (or (endp l)
      (and (pointp (car l))
           (point-on-twisted-edwards-p (car l) curve)
           (te-all-on-curve-p (cdr l) curve))))

(define te-sum ((l true-listp) (curve twisted-edwards-curvep))
  :verify-guards nil
  (if (endp l)
      (twisted-edwards-zero)
    (twisted-edwards-add (car l) (te-sum (cdr l) curve) curve)))

(define te-shift ((l true-listp) (q pointp) (curve twisted-edwards-curvep))
  :verify-guards nil
  (if (endp l)
      nil
    (cons (twisted-edwards-add (car l) q curve)
          (te-shift (cdr l) q curve))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defrule pointp-of-te-sum
  (pointp (te-sum l curve))
  :enable te-sum)

(defrule point-on-twisted-edwards-p-of-te-sum
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve))
           (point-on-twisted-edwards-p (te-sum l curve) curve))
  :enable (te-sum te-all-on-curve-p))

(defruled twisted-edwards-add-commutative-2
  (implies (and (twisted-edwards-curve-completep curve)
                (point-on-twisted-edwards-p a curve)
                (point-on-twisted-edwards-p b curve)
                (point-on-twisted-edwards-p c curve))
           (equal (twisted-edwards-add a (twisted-edwards-add b c curve) curve)
                  (twisted-edwards-add b (twisted-edwards-add a c curve) curve)))
  :use ((:instance twisted-edwards-add-associative-right
                   (point1 a) (point2 b) (point3 c))
        (:instance twisted-edwards-add-associative-right
                   (point1 b) (point2 a) (point3 c))
        (:instance twisted-edwards-add-commutative
                   (point1 a) (point2 b)))
  :disable (twisted-edwards-add-associative-right
            twisted-edwards-add-commutative))

(defrule te-all-on-curve-p-of-remove1
  (implies (te-all-on-curve-p l curve)
           (te-all-on-curve-p (remove1-equal a l) curve))
  :enable te-all-on-curve-p)

(defruled te-sum-when-member
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve)
                (member-equal a l))
           (equal (te-sum l curve)
                  (twisted-edwards-add a (te-sum (remove1-equal a l) curve)
                                       curve)))
  :induct (len l)
  :enable (te-sum te-all-on-curve-p)
  :hints (("Subgoal *1/1"
           :use ((:instance twisted-edwards-add-commutative-2
                            (a a) (b (car l))
                            (c (te-sum (remove1-equal a (cdr l)) curve)))))))

(defruled te-sum-when-perm
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p x curve)
                (te-all-on-curve-p y curve)
                (acl2::perm x y))
           (equal (te-sum x curve) (te-sum y curve)))
  :induct (acl2::perm x y)
  :enable (acl2::perm te-sum te-all-on-curve-p)
  :hints (("Subgoal *1/2"
           :use (:instance te-sum-when-member (a (car x)) (l y)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defrule te-all-on-curve-p-of-te-shift
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve)
                (te-all-on-curve-p l curve))
           (te-all-on-curve-p (te-shift l q curve) curve))
  :enable (te-shift te-all-on-curve-p))

(defruled te-sum-of-te-shift
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve)
                (te-all-on-curve-p l curve))
           (equal (te-sum (te-shift l q curve) curve)
                  (twisted-edwards-add (te-sum l curve)
                                       (twisted-edwards-mul (len l) q curve)
                                       curve)))
  :induct (len l)
  :enable (te-sum te-shift te-all-on-curve-p len)
  :hints (("Subgoal *1/1"
           :use ((:instance twisted-edwards-mul-succ
                            (point q) (n (len (cdr l))))
                 (:instance twisted-edwards-add-commutative-2
                            (a q) (b (te-sum (cdr l) curve))
                            (c (twisted-edwards-mul (len (cdr l)) q curve)))
                 (:instance twisted-edwards-add-commutative-2
                            (a q) (b (car l))
                            (c (te-sum (te-shift (cdr l) q curve) curve)))))))

(defruled member-of-te-shift-when-member
  (implies (member-equal x l)
           (member-equal (twisted-edwards-add x q curve) (te-shift l q curve)))
  :enable te-shift)

(defruled twisted-edwards-add-shift-unshift
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp p) (pointp q)
                (point-on-twisted-edwards-p p curve)
                (point-on-twisted-edwards-p q curve))
           (equal (twisted-edwards-add q
                                       (twisted-edwards-add
                                        p (twisted-edwards-neg q curve) curve)
                                       curve)
                  p))
  :use (:instance twisted-edwards-add-commutative-2
                  (a q) (b p) (c (twisted-edwards-neg q curve))))

(defruled twisted-edwards-add-neg-shift
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp p) (pointp q)
                (point-on-twisted-edwards-p p curve)
                (point-on-twisted-edwards-p q curve))
           (equal (twisted-edwards-add (twisted-edwards-neg q curve)
                                       (twisted-edwards-add q p curve)
                                       curve)
                  p))
  :use (:instance twisted-edwards-add-associative-right
                  (point1 (twisted-edwards-neg q curve))
                  (point2 q) (point3 p))
  :disable twisted-edwards-add-associative-right)

(defruled member-of-te-shift-when-on-curve
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve)
                (member-equal x (te-shift l q curve)))
           (member-equal (twisted-edwards-add x
                                              (twisted-edwards-neg q curve)
                                              curve)
                         l))
  :induct (len l)
  :enable (te-shift te-all-on-curve-p twisted-edwards-add-shift-unshift))

(defruled te-shift-no-duplicates
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve)
                (no-duplicatesp-equal l))
           (no-duplicatesp-equal (te-shift l q curve)))
  :induct (len l)
  :enable (te-shift te-all-on-curve-p twisted-edwards-add-neg-shift)
  :hints (("Subgoal *1/1"
           :use (:instance member-of-te-shift-when-on-curve
                           (x (twisted-edwards-add (car l) q curve))
                           (l (cdr l))))))

(defrule pointp-when-member-of-te-all-pts
  (implies (member-equal pt (te-all-pts curve))
           (pointp pt))
  :enable te-all-pts)

(defruled te-all-on-curve-p-of-te-all-pts-sub
  (implies (and (twisted-edwards-curve-completep curve)
                (subsetp-equal l (te-all-pts curve)))
           (te-all-on-curve-p l curve))
  :induct (len l)
  :enable (te-all-on-curve-p subsetp-equal)
  :hints (("Subgoal *1/1"
           :use (:instance member-te-all-pts (pt (car l))))))

(defrule te-all-on-curve-p-of-te-all-pts
  (implies (twisted-edwards-curve-completep curve)
           (te-all-on-curve-p (te-all-pts curve) curve))
  :use (:instance te-all-on-curve-p-of-te-all-pts-sub
                  (l (te-all-pts curve))))

(defruled subsetp-te-shift-te-all-pts
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve))
           (subsetp-equal (te-shift l q curve) (te-all-pts curve)))
  :induct (len l)
  :enable (te-shift te-all-on-curve-p subsetp-equal))

(defruled subsetp-te-all-pts-te-shift
  (implies (and (twisted-edwards-curve-completep curve)
                (te-all-on-curve-p l curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve))
           (subsetp-equal l (te-shift (te-all-pts curve) q curve)))
  :induct (len l)
  :enable (te-all-on-curve-p subsetp-equal)
  :hints (("Subgoal *1/1"
           :use ((:instance member-of-te-shift-when-member
                            (x (twisted-edwards-add (car l)
                                                    (twisted-edwards-neg q curve)
                                                    curve))
                            (l (te-all-pts curve)))
                 (:instance twisted-edwards-add-associative-right
                            (point1 (car l))
                            (point2 (twisted-edwards-neg q curve))
                            (point3 q))))))

(defruled perm-te-shift-te-all-pts
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve))
           (acl2::perm (te-shift (te-all-pts curve) q curve)
                 (te-all-pts curve)))
  :use ((:instance acl2::perm-of-append-of-set-difference-equal-same
                   (x (te-all-pts curve))
                   (y (te-shift (te-all-pts curve) q curve)))
        (:instance subsetp-te-shift-te-all-pts (l (te-all-pts curve)))
        (:instance subsetp-te-all-pts-te-shift (l (te-all-pts curve)))
        (:instance te-shift-no-duplicates (l (te-all-pts curve)))))

(define te-point-count ((curve twisted-edwards-curvep))
  :verify-guards nil
  (len (te-all-pts curve)))

(defrule te-point-count-upper-bound
  (<= (te-point-count curve)
      (* 2 (twisted-edwards-curve->p curve)))
  :rule-classes :linear
  :enable te-point-count)

(defrule twisted-edwards-mul-of-te-point-count
  (implies (and (twisted-edwards-curve-completep curve)
                (pointp q)
                (point-on-twisted-edwards-p q curve))
           (equal (twisted-edwards-mul (te-point-count curve) q curve)
                  (twisted-edwards-zero)))
  :enable te-point-count
  :use ((:instance te-sum-of-te-shift (l (te-all-pts curve)))
        (:instance te-sum-when-perm
                   (x (te-shift (te-all-pts curve) q curve))
                   (y (te-all-pts curve)))
        perm-te-shift-te-all-pts
        (:instance twisted-edwards-add-cancel-left
                   (point (te-sum (te-all-pts curve) curve))
                   (point1 (twisted-edwards-mul (len (te-all-pts curve))
                                                q curve))
                   (point2 (twisted-edwards-zero)))))
